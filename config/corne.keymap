#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "tap-preferred";
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        as: as {
            compatible = "zmk,behavior-hold-tap";
            label = "AS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        CapsWord {
            bindings = <&caps_word>;
            key-positions = <16 19>;
            layers = <0>;
            timeout-ms = <20>;
        };

        Enter {
            bindings = <&kp ENTER>;
            key-positions = <16 15>;
            timeout-ms = <20>;
            layers = <0 1>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <16 17>;
            timeout-ms = <20>;
            layers = <0>;
        };

        Delete {
            bindings = <&kp DELETE>;
            key-positions = <4 3>;
            timeout-ms = <20>;
            layers = <0 1>;
        };

        Paste {
            bindings = <&kp LC(V)>;
            key-positions = <28 29>;
            timeout-ms = <20>;
            layers = <0>;
        };

        Copy {
            bindings = <&kp LC(C)>;
            key-positions = <27 28>;
            timeout-ms = <20>;
            layers = <0>;
        };

        Cut {
            bindings = <&kp LC(X)>;
            key-positions = <26 27>;
            timeout-ms = <20>;
            layers = <0>;
        };

        Undo {
            bindings = <&kp LC(Z)>;
            key-positions = <14 15>;
            timeout-ms = <20>;
            layers = <0>;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <2 3>;
            timeout-ms = <20>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Alpha";
            bindings = <
&none  &as LS(Q) Q  &as LS(W) W  &as LS(F) F  &as LS(P) P  &as LS(B) B        &as LS(J) J  &as LS(L) L  &as LS(U) U          &as LS(Y) Y       &as LS(SQT) APOS          &none
&none  &as LS(A) A  &as LS(R) R  &as LS(S) S  &as LS(T) T  &as LS(G) G        &as LS(M) M  &as LS(N) N  &as LS(E) E          &as LS(I) I       &as LS(O) O               &none
&none  &as LS(Z) Z  &as LS(X) X  &as LS(C) C  &as LS(D) D  &as LS(V) V        &as LS(K) K  &as LS(H) H  &as SEMICOLON COMMA  &as COLON PERIOD  &as EXCLAMATION QUESTION  &none
                                 &none        &none        &lt 1 BACKSPACE    &lt 2 SPACE  &none        &none
            >;
        };

        NumNav {
            label = "NumNav";
            bindings = <
&none  &none         &kp N7           &kp N8        &kp N9        &kp N0        &none      &none           &kp UP_ARROW    &none      &none  &none
&none  &kp LEFT_GUI  &mt LEFT_ALT N4  &mt LCTRL N5  &mt LSHFT N6  &kp PERIOD    &none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT  &none  &none
&none  &none         &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp MINUS     &none      &none           &none           &none      &none  &none
                                      &none         &none         &none         &kp SPACE  &none           &none
            >;
        };

        SymSys {
            bindings = <
&none  &kp CARET     &kp PIPE        &kp BACKSLASH  &kp SLASH  &kp EQUAL        &kp GRAVE    &kp LBKT  &kp RBKT  &none  &bt BT_NXT      &none
&none  &kp ASTERISK  &kp HASH        &kp AMPERSAND  &kp AT     &kp PLUS         &kp PERCENT  &kp LPAR  &kp RPAR  &none  &bt BT_PRV      &none
&none  &kp TILDE     &kp UNDERSCORE  &kp LT         &kp GT     &kp MINUS        &kp DOLLAR   &kp LBRC  &kp RBRC  &none  &bt BT_CLR_ALL  &none
                                     &none          &none      &kp BACKSPACE    &trans       &none     &none
            >;

            label = "SymSys";
        };
    };
};
